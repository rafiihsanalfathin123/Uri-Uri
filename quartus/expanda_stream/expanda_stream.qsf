set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY expanda_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_global_assignment -name SEED 1
set_global_assignment -name SDC_FILE ../../quartus/expanda.sdc
# Out-of-context IP fitting. These are not board pin assignments.
set_global_assignment -name VERILOG_FILE ../../rtl/expanda_controller.v
set_global_assignment -name VERILOG_FILE ../../rtl/expanda_seed_absorb.v
set_global_assignment -name VERILOG_FILE ../../rtl/expanda_shake128.v
set_global_assignment -name VERILOG_FILE ../../rtl/expanda_xof_buffer.v
set_global_assignment -name VERILOG_FILE ../../rtl/expanda_rej_ntt_poly.v
set_global_assignment -name VERILOG_FILE ../../rtl/expanda_output_packer.v
set_global_assignment -name VERILOG_FILE ../../rtl/expanda_top.v
set_global_assignment -name EDA_SIMULATION_TOOL "Questa Intel FPGA (Verilog)"
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_ENABLE_STATUS TEST_BENCH_MODE -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_NAME tb_expanda_v2 -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_MODULE_NAME tb_expanda_v2 -section_id tb_expanda_v2
set_global_assignment -name EDA_TEST_BENCH_DESIGN_INSTANCE_NAME dut -section_id tb_expanda_v2
set_global_assignment -name EDA_TEST_BENCH_FILE ../../tb/tb_expanda_v2.v -section_id tb_expanda_v2
set_global_assignment -name EDA_TEST_BENCH_RUN_SIM_FOR "20 ms" -section_id tb_expanda_v2
set_parameter -name PARALLEL_LANES 5
# Standalone IP evaluation only: these are NOT board pin assignments.
set_instance_assignment -name VIRTUAL_PIN ON -to "rst"
set_instance_assignment -name VIRTUAL_PIN ON -to "rho_data[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "rho_valid"
set_instance_assignment -name VIRTUAL_PIN ON -to "rho_ready"
set_instance_assignment -name VIRTUAL_PIN ON -to "rho_loaded"
set_instance_assignment -name VIRTUAL_PIN ON -to "expand_a_start"
set_instance_assignment -name VIRTUAL_PIN ON -to "expand_a_ready"
set_instance_assignment -name VIRTUAL_PIN ON -to "expand_a_busy"
set_instance_assignment -name VIRTUAL_PIN ON -to "expand_a_done"
set_instance_assignment -name VIRTUAL_PIN ON -to "expand_a_error"
set_instance_assignment -name VIRTUAL_PIN ON -to "sampled_poly_data[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "sampled_poly_valid"
set_instance_assignment -name VIRTUAL_PIN ON -to "sampled_poly_ready"
set_instance_assignment -name VIRTUAL_PIN ON -to "sampled_poly_idx[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "sampled_word_idx[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "sampled_poly_last"
set_instance_assignment -name VIRTUAL_PIN OFF -to clk

set_global_assignment -name LAST_QUARTUS_VERSION "23.1std.1 Lite Edition"
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top