set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY expanda_buffered_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_global_assignment -name SEED 1
set_global_assignment -name SDC_FILE ../clock.sdc
set_parameter -name ROWS 1
set_parameter -name PARALLEL_LANES 5
set_global_assignment -name VERILOG_FILE ../rtl/expanda_controller.v
set_global_assignment -name VERILOG_FILE ../rtl/expanda_seed_absorb.v
